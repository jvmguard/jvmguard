---
// Home.astro: the landing page, shared by all locales. Copy comes from the
// locale's message catalog in src/i18n/ui.ts.
import fs from 'node:fs';
import PageFrame from '../../layouts/PageFrame.astro';
import {SITE} from '../../consts';
import {
  DEFAULT_LOCALE,
  getMessages,
  homeFeatures,
  homeSteps,
  htmlLang,
  localeUrl,
  type Locale,
} from '../../i18n/ui';

interface Props {
  locale?: Locale;
}
const {locale = DEFAULT_LOCALE} = Astro.props;
const m = getMessages(locale);

const features = homeFeatures(m);
const steps = homeSteps(m);

// Localized screenshots live in images/ui/generated/<locale>/ and are generated, not committed; fall
// back to the committed English image when the locale variant is absent (checked on disk at build time).
const shotDir = locale === DEFAULT_LOCALE ? '' : `generated/${htmlLang(locale)}/`;
const hasLocalizedShot =
  shotDir !== '' && fs.existsSync(`public/images/ui/${shotDir}profiling_options.png`);
const shotBase = `/images/ui/${hasLocalizedShot ? shotDir : ''}profiling_options`;
---

<PageFrame
  active="overview"
  locale={locale}
  title={m['home.meta.title']}
  description={m['home.meta.description']}
>
  <section class="shell shell--wide hero">
    <p class="eyebrow">{m['home.hero.eyebrow']}</p>
    <h1>{m['home.hero.title.1']} <br />{m['home.hero.title.2']} <br />{m['home.hero.title.3']}</h1>
    <p class="lede">
      {m['home.hero.lede']}
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href={localeUrl(locale, '/download')}>{m['home.hero.cta.download']}</a>
      <a class="btn btn--ghost" href={SITE.docs}>{m['home.hero.cta.docs']}</a>
      <a class="btn btn--ghost" href={SITE.repo}>{m['home.hero.cta.github']}</a>
    </div>
    <p class="hero__cred">{m['home.hero.cred']}</p>
  </section>

  <section class="shell shell--wide shot-wrap">
    <figure class="shot">
      <img class="shot__img shot__img--light" src={`${shotBase}.png`}
           alt={m['home.shot.alt']} />
      <img class="shot__img shot__img--dark" src={`${shotBase}_dark.png`}
           alt="" aria-hidden="true" />
      <figcaption>
        {m['home.shot.caption']}
      </figcaption>
    </figure>
  </section>

  <section class="shell shell--wide">
    <div class="rule">
      <span class="rule__no">§ 01</span>
      <span class="rule__label">{m['home.features.rule']}</span>
    </div>
    <div class="grid grid--2">
      {features.map((f) => (
        <article class="feature">
          <h3>{f.title}</h3>
          <p class="muted">{f.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell shell--wide">
    <div class="rule">
      <span class="rule__no">§ 02</span>
      <span class="rule__label">{m['home.steps.rule']}</span>
    </div>
    <div class="grid grid--3 steps">
      {steps.map((s) => (
        <article class="step">
          <span class="step__no">{s.no}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell shell--wide">
    <div class="rule">
      <span class="rule__no">§ 03</span>
      <span class="rule__label">{m['home.open.rule']}</span>
    </div>
    <div class="panel open">
      <p>
        {m['home.open.p1']}
      </p>
      <p>
        {m['home.open.p2']}
      </p>
      <div class="btn-row">
        <a class="btn btn--ghost" href={localeUrl(locale, '/compare')}>{m['home.open.cta']}</a>
      </div>
    </div>
  </section>

  <section class="shell shell--wide">
    <div class="rule">
      <span class="rule__no">§ 04</span>
      <span class="rule__label">{m['home.agent.rule']}</span>
    </div>
    <div class="panel open">
      <p>
        {m['home.agent.p1']}
      </p>
      <p>
        {m['home.agent.p2']}
      </p>
      <div class="btn-row">
        <a class="btn btn--ghost" href={localeUrl(locale, '/security')}>{m['home.agent.cta']}</a>
      </div>
    </div>
  </section>
</PageFrame>

<style>
  .hero {
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  .hero h1 {
    max-width: 28ch;
  }
  .hero h1 br {
    display: none;
  }
  @media (min-width: 820px) {
    .hero h1 br {
      display: inline;
    }
  }
  .hero__cred {
    margin-top: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .step {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }
  .step__no {
    display: block;
    color: var(--brand);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .step h3 {
    margin-top: 0;
  }
  .shot-wrap {
    padding-inline: 16px;
  }
  .shot {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-align: center;
  }
  @media (max-width: 820px) {
    .shot {
      margin-inline: 0;
    }
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .shot .shot__img--dark {
    display: none;
  }
  :root[data-theme="dark"] .shot__img--light {
    display: none;
  }
  :root[data-theme="dark"] .shot__img--dark {
    display: block;
  }
  .shot figcaption {
    margin-top: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--step--1);
    max-width: 70ch;
    margin-inline: auto;
  }
  .feature {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }
  .feature h3 {
    margin-top: 0;
  }
  .open p {
    max-width: none;
  }
</style>
